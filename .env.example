# AI Council
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Council Chair — independently configurable from ordinary membership
CHAIR_PROVIDER=openai
CHAIR_MODEL=

# Council behavior
# First live-pilot policy: all four members must participate successfully.
STRICT_COUNCIL=true
MIN_COUNCIL_RESPONSES=4
MAX_COUNCIL_REASONING_ROUNDS=3
MAX_IMPLEMENTATION_ITERATIONS=12
AI_RESPONSE_REPAIR_ATTEMPTS=1

# Provider retries
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=400
AI_RETRY_MAX_MS=4000

# Timeouts (milliseconds)
AI_REQUEST_TIMEOUT_MS=120000
CURSOR_REQUEST_TIMEOUT_MS=600000
CURSOR_CLOUD_RUN_TIMEOUT_MS=1800000

# Cursor
# CURSOR_MODE=mock is permitted only when DEMO_MODE=true or in automated tests.
CURSOR_MODE=acp
CURSOR_AGENT_BIN=agent
CURSOR_API_KEY=
CURSOR_CLOUD_API_KEY=
CURSOR_AUTH_TOKEN=
CURSOR_PROJECT_PATH=
CURSOR_REPO_URL=
CURSOR_STARTING_REF=main
CURSOR_CLOUD_AUTO_CREATE_PR=false
CURSOR_CLOUD_WORK_ON_CURRENT_BRANCH=false
WORKSPACE_DIR=./workspaces
MANAGED_WORKSPACE_ROOT=./workspaces
AUTONOMOUS_BRANCH_PREFIX=adp
PROTECTED_BRANCH_PATTERNS=main,master,production,release/*

# ACP permission policy: deny | safe-development | allow-all
# Default is safe-development. allow-all is an explicit development override only.
ACP_PERMISSION_POLICY=safe-development
CURSOR_PERMISSION_POLICY=safe-development

# Optional extra env vars passed to the Cursor ACP child (comma-separated).
# Platform AI keys and DATABASE_URL are never inherited.
CURSOR_CHILD_ENV_ALLOW=
# Project-scoped runtime variables for generated-app execution (names only in logs).
CURSOR_PROJECT_ENV_ALLOW=

# Server
PORT=4317
DATA_DIR=./data
# Live runtimes must keep DEMO_MODE=false. Mock backends are illegal outside demo/test.
DEMO_MODE=false
APP_ROLE=api
IMPORT_JSON_ON_START=false

# Durable execution (PostgreSQL). Required outside DEMO_MODE.
# Local Docker: postgres://adp:adp@127.0.0.1:5432/adp
# Local PGlite socket: npm run db then postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=

# Worker / job queue
WORKER_POLL_MS=400
WORKER_CONCURRENCY=1
JOB_LEASE_MS=900000
JOB_HEARTBEAT_MS=30000
JOB_MAX_ATTEMPTS=8
JOB_RETRY_BASE_MS=2000
JOB_RETRY_MAX_MS=60000

# Isolated demo/test engine when DATABASE_URL is unset and DEMO_MODE=true
PGLITE_DATA_DIR=

# PostgreSQL integration tests only (`npm run test:postgres`).
# Must be an isolated database whose name includes "test" (recommended: adp_phase3_test).
# Normal `npm test` never reads this. Do not point this at a production database.
TEST_DATABASE_URL=

# Platform verification (Phase 5)
VERIFY_INSTALL_TIMEOUT_MS=300000
VERIFY_BUILD_TIMEOUT_MS=300000
VERIFY_TEST_TIMEOUT_MS=300000
VERIFY_LINT_TIMEOUT_MS=180000
VERIFY_OUTPUT_PREVIEW_BYTES=8000
VERIFY_MAX_LOG_BYTES=1000000
VERIFY_SECURITY_ENABLED=true
ARTIFACT_ROOT=./artifacts
VERIFICATION_CONCURRENCY=1

# Phase 6 runtime / visual
RUNTIME_READY_TIMEOUT_MS=30000
RUNTIME_MAX_SCENARIOS=8
VISUAL_MAX_SCREENSHOTS=12
VISUAL_CRITICAL_REVIEWERS=3
VISUAL_SECONDARY_REVIEWERS=1
PLAYWRIGHT_INSTALL_ON_PROJECT=false
OPENAI_VISION=
ANTHROPIC_VISION=
GEMINI_VISION=
XAI_VISION=

# Phase 7 provisioning
DEFAULT_APP_ORGANIZATION=com.autonomous.generated
PROVISIONER_VERSION_POLICY=CURRENT_SUPPORTED
PROVISIONING_TIMEOUT_MS=300000
PROVISIONING_NETWORK_ENABLED=true
PROVISIONING_MAX_LOG_BYTES=1000000

# Phase 8 security / sandbox
# DEVELOPMENT permits LOCAL_DEVELOPMENT_UNSAFE explicitly.
# STANDARD/HARDENED require a container engine and never silently fall back to host execution.
# SANDBOX_BACKEND=mock is permitted only when DEMO_MODE=true or in automated tests.
SECURITY_PROFILE=STANDARD
SANDBOX_BACKEND=auto
SANDBOX_REQUIRED=
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_PIDS_LIMIT=256
SANDBOX_DISK_LIMIT_MB=2048
SANDBOX_TIMEOUT_MS=300000
SANDBOX_LOG_LIMIT_BYTES=1000000
SANDBOX_NETWORK_POLICY=

# Secret broker: encrypted-local | vault | mock
# mock is permitted only when DEMO_MODE=true or in automated tests.
SECRET_BROKER=encrypted-local
SECRET_MASTER_KEY=
SECRET_STORE_PATH=
VAULT_ADDR=
VAULT_AUTH_METHOD=
VAULT_TOKEN=

# Owner authentication is token-first. Provide a bootstrap token; the platform stores only its hash.
OWNER_AUTH_MODE=token
OWNER_TOKEN_BOOTSTRAP=
WORKER_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:4317,http://localhost:4317
